# Plaid: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox

# Claude: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Model for the Ask tab. Haiku 5.5 is the cheap default; the app does the math
# itself, so Haiku only has to explain it. Use claude-sonnet-5-5 or
# claude-opus-5-5 if you want deeper planning advice.
ANTHROPIC_MODEL=claude-haiku-5-5
# How hard it thinks: low | medium | high | xhigh | max. Higher costs more per answer.
ANTHROPIC_EFFORT=medium

PORT=8787
