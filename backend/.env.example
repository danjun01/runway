# Plaid: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox

# Claude: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Model for the Ask tab. Opus 5.5 by default; claude-sonnet-5-5 is about half the price.
ANTHROPIC_MODEL=claude-opus-5-5
# How hard it thinks: low | medium | high | xhigh | max. Higher costs more per answer.
ANTHROPIC_EFFORT=medium

PORT=8787
